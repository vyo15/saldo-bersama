# Frontend public configuration (values are embedded in the browser bundle)
VITE_APP_NAME=Saldo Bersama
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_VAPID_PUBLIC_KEY=

# Vercel Functions / local API configuration
LOG_LEVEL=info
FIREBASE_WEB_API_KEY=
ALLOWED_USERS_JSON=[{"email":"owner@gmail.com","role":"owner"},{"email":"pasangan@gmail.com","role":"member"}]
ALLOWED_ORIGINS=http://localhost:5173,https://saldo-bersama.vercel.app
SESSION_SECRET=

# Turso source of truth (server-only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signed Google integration bridge (server-only)
GOOGLE_BRIDGE_WEB_APP_URL=
GOOGLE_BRIDGE_SHARED_SECRET=
MIRROR_SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=
BACKUP_FOLDER_ID=

# Signed scheduled jobs endpoint (same value is stored in Apps Script Properties)
JOBS_SHARED_SECRET=
JOBS_ENDPOINT_URL=https://saldo-bersama.vercel.app/api/jobs

# Optional Web Push server configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
