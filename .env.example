# Saldo Bersama environment template
# Copy to .env.local only for local development. Never commit .env, .env.local, or real secret values.

# Public browser configuration (included in the Vite bundle; do not put secrets here)
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_APP_NAME=Saldo Bersama
VITE_DEMO_MODE=false
VITE_VAPID_PUBLIC_KEY=

# Vercel server-only configuration (never prefix these with VITE_)
# FIREBASE_WEB_API_KEY normally uses the same Firebase Web API key as VITE_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=

# Roles are strict: only owner or member. Invalid email/role and conflicting duplicates are rejected.
ALLOWED_USERS_JSON=[{"email":"owner@example.com","role":"owner"},{"email":"partner@example.com","role":"member"}]

# Exact origins only; no wildcard and no trailing slash.
# Local example: http://localhost:5173,http://localhost:3000
# Production example: https://saldo-bersama.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Generate each secret separately; minimum 32 characters. Never reuse the same value.
SESSION_SECRET=
INTERNAL_SHARED_SECRET=

# Apps Script Web App deployment URL ending in /exec.
APPS_SCRIPT_WEB_APP_URL=

# Optional Web Push configuration
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Apps Script Script Properties (documentation only; configure in Apps Script Project Settings)
# INTERNAL_SHARED_SECRET = exactly the same value as the Vercel variable above
# SPREADSHEET_ID = created automatically by setupSaldoBersama()
# CALENDAR_ID = optional shared Google Calendar ID
# BACKUP_FOLDER_ID = optional dedicated Google Drive backup folder ID
# PUSH_ENDPOINT_URL = optional production URL, for example https://saldo-bersama.vercel.app/api/push
