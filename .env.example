# Saldo Bersama — canonical environment
# Vercel Development dipakai untuk bootstrap lokal tepercaya, Production untuk deployment, dan Preview dibiarkan kosong.
# Runtime lokal membaca .env.local yang disimpan aman dan tidak pernah di-commit.
# Nilai VITE_* masuk ke bundle browser; jangan taruh secret pada VITE_*.

# Public frontend — required
VITE_APP_NAME=Saldo Bersama
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=saldo-bersama.firebaseapp.com

# Core backend — required
# Bootstrap/recovery Administrator only. Anggota operasional dikelola dari Pengaturan → Anggota dan disimpan di tabel users.
ALLOWED_USERS_JSON=[{"email":"admin@gmail.com","role":"administrator"}]
ALLOWED_ORIGINS=http://localhost:5173,https://saldo-bersama.vercel.app
SESSION_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_ENVIRONMENT=

# Production-only Google OAuth server flow — required on Vercel Production, never expose as VITE_*
GOOGLE_OAUTH_CLIENT_SECRET=

# Runtime logging — optional
LOG_LEVEL=info

# Google bridge — optional; enable centrally as one complete group
GOOGLE_BRIDGE_WEB_APP_URL=
GOOGLE_BRIDGE_SHARED_SECRET=
JOBS_SHARED_SECRET=

# Web Push — required for canonical local testing; use one matching pair across trusted Development and Production
# Do not generate a pair per computer. Prefer mailto:. HTTPS subjects must use a public hostname, never localhost or a private IP.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gmail.com
